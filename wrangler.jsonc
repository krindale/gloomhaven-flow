{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gloomhaven-flow",
  "compatibility_date": "2026-09-28",
  "observability": {
    "enabled": true
  },
  // 빌드 없음. 배포 워크플로가 index.html + css/ js/ data/ assets/ 만 dist/ 로 복사해 올린다(tools·문서·.git 제외).
  "assets": {
    "directory": "./dist"
  }
}
